{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Armstrong Fitness",
  "version": "0.1.0",
  "identifier": "lk.armstrong.fitness",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:4173" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Armstrong Fitness — Local SQLite test", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false, "icon": [] }
}
