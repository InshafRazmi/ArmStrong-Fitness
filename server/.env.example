# Server only. Never copy these values to Client or commit a populated file.
DATABASE_URL="postgresql://armstrong_api.REPLACE_PROJECT_REF:REPLACE_ENCODED_PASSWORD@REPLACE_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=./prod-ca-2021.crt"
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE
# Optional local `npm run auth:check` credentials, not needed by API startup.
# Use the ONE Administrator account in this same Supabase project.
# AUTH_CHECK_EMAIL=REPLACE_ADMIN_EMAIL
# AUTH_CHECK_PASSWORD=REPLACE_ADMIN_PASSWORD
# Optional administrative registration; review with registration:check before apply.
# `npm run setup:check` reports missing local settings without printing values.
# REGISTRATION_GYM_ID=REPLACE_APPROVED_STABLE_GYM_UUID
# REGISTRATION_GYM_NAME=REPLACE_APPROVED_GYM_NAME
# REGISTRATION_ADMIN_NAME=REPLACE_ADMIN_DISPLAY_NAME
# Optional device approval requires BOTH entries and a native-stored device secret.
# SQLite is opened read-only; its existing device UUID is used, never replaced.
# REGISTRATION_SQLITE_PATH=REPLACE_EXISTING_DESKTOP_DATABASE_PATH
# REGISTRATION_DEVICE_SECRET_SHA256=REPLACE_SHA256_OF_NATIVE_HEX_SECRET_STRING
HOST=127.0.0.1
AUTOMATIC_DEVICE_ENROLLMENT=false
# After migrating and registering the approved Administrator, set true on Render
# to enable account-authorized computers. First computer edits; later ones view.
PORT=3000
# Required for local setup/custom domains; use the ACTUAL deployed HTTPS origin:
# PUBLIC_API_ORIGIN=https://YOUR-ACTUAL-APP.onrender.com
# On Render, API startup also accepts its automatic RENDER_EXTERNAL_URL when
# RENDER=true and PUBLIC_API_ORIGIN is absent. Local desktop setup still needs
# PUBLIC_API_ORIGIN copied from that actual deployed service.
# Deployed DATABASE_URL must use the restricted role and mounted CA path:
# sslrootcert=/etc/secrets/prod-ca-2021.crt (keep sslmode=verify-full).
# `npm run api:check` probes the existing HTTPS API; it does not deploy a server.
# After actual native preparation, review with desktop:config:check and provision
# with desktop:config:write. Only public Auth/API settings enter desktop-auth.json.
# NODE_ENV=production
# Production API startup refuses postgres and built-in database roles. Use the
# separately provisioned restricted runtime login with verified grants. Owner
# connections remain for administrative registration/migration/probes only.
# Integration tests use a separate ignored .env.test, never runtime fallback.
# See docs/SUPABASE_TESTING.md. Copy the TEST_* entries there and fill locally.
# TEST_PROJECT_IS_DISPOSABLE=true
# TEST_SUPABASE_PROJECT_REF=REPLACE_PROJECT_REF
# TEST_DATABASE_URL="postgresql://postgres.REPLACE_TEST_PROJECT_REF:REPLACE_ENCODED_PASSWORD@REPLACE_TEST_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=./prod-ca-2021.crt"
# Copy each project's actual Session pooler hostname from its Connect dialog.
# Port 5432 only; transaction pooling (6543) is not supported here.
# CA paths resolve from server/; provision each project's correct CA locally.
# TEST_SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
# TEST_SUPABASE_PUBLISHABLE_KEY=REPLACE_PUBLISHABLE_KEY
# TEST_ADMIN_EMAIL=REPLACE_TEST_ADMIN_EMAIL
# TEST_ADMIN_PASSWORD=REPLACE_TEST_ADMIN_PASSWORD
# TEST_RECEPTION_EMAIL=REPLACE_TEST_RECEPTION_EMAIL
# TEST_RECEPTION_PASSWORD=REPLACE_TEST_RECEPTION_PASSWORD
# TEST_OTHER_GYM_EMAIL=REPLACE_TEST_OTHER_GYM_EMAIL
# TEST_OTHER_GYM_PASSWORD=REPLACE_TEST_OTHER_GYM_PASSWORD
